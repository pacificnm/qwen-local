# ==========================================
# Application Settings
# ==========================================
APP_ENV=development
# Random 32+ byte string; signs/validates the session cookie (SECRET_KEY)
SECRET_KEY=change-me-32-bytes-min
# Single shared account, seeded by scripts/init_db.py (argon2id)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-on-first-boot

# ==========================================
# Database (Host PostgreSQL + pgvector)
# Use host.docker.internal to reach the host machine from Docker
# ==========================================
DATABASE_URL=postgresql://username:password@host.docker.internal:5432/qwen_chat_db

# ==========================================
# Ollama (PRE-EXISTING — app only consumes this endpoint)
# No model pulls/tuning are performed by the app.
# keep_alive=60s: idle model unloads after 60s, freeing V100 VRAM
# ==========================================
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_FAST_MODEL=qwen3.5:4b
OLLAMA_STRONG_MODEL=qwen3.8:27b-longctx
OLLAMA_COMPACTION_MODEL=qwen3.5:4b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_KEEP_ALIVE=60s

# ==========================================
# GitHub (single static PAT, repo scope — never sent to the browser)
# ==========================================
GITHUB_PAT=ghp_xxxxxxxxxxxxxxxxxxxx

# ==========================================
# Web Search (self-hosted SearXNG, JSON API enabled)
# ==========================================
SEARXNG_URL=http://searxng:8080   # compose-internal; use http://host.docker.internal:8080 from host tools

# ==========================================
# Sandbox (ephemeral code-interpreter containers)
# ==========================================
SANDBOX_IMAGE_NAME=qwen-code-sandbox:latest
SANDBOX_TIMEOUT_SECONDS=120   # hard kill on exceed (SIGKILL)
SANDBOX_MEMORY=1g
SANDBOX_CPUS=2
SANDBOX_NETWORK=none          # locked: no network in sandbox
# Hardening (spec §5.3): drop-all capabilities, no-new-privileges, unprivileged user
SANDBOX_USER=65534:65534
SANDBOX_TMPFS=/tmp:rw,size=64m
SANDBOX_PIDS_LIMIT=256
# Dev fallback: `docker build` context (repo-relative) used by ensure_image() when
# the qwen-code-sandbox:latest image is missing (compose builds it via sandbox-image)
SANDBOX_BUILD_CONTEXT=sandbox
